import java.util.Scanner;

public class Main7 {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
        System.out.println("Nhap so: ");
        int n = sc.nextInt();

		int[] arr = new int[n];
		for(int i=0; i<n; i++) {
			System.out.println("Nhap so nguyen thu " + (i+1) + ":");
			arr[i] = sc.nextInt();
		}
		sc.close();
		
		for(int i = 0; i<n; i++) {
		if(arr[i] == 0) {
			System.out.println(" co " + i + "phan tu trong mang = 0");
		}else if(arr[i] < 0) {
			System.out.println(" co " + i + "phan tu trong mang < 0");
		}else if(arr[i] > 0) {
			System.out.println(" co " + i + "phan tu trong mang > 0");
		}
	}
}
